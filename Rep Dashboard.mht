@charset "utf-8";

body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; background: rgb(13, 10, 18); color: rgb(226, 232, 240); margin: 0px; padding: 20px; overflow-x: hidden; position: relative; min-height: 100vh; }

