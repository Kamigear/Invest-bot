button { padding: 10px 15px; background: rgb(168, 85, 247); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; border-radius: 6px; font-weight: bold; transition: 0.2s; }

button:hover:not(:disabled) { background: rgb(147, 51, 234); box-shadow: rgba(168, 85, 247, 0.4) 0px 0px 10px; }

button:disabled { cursor: not-allowed; opacity: 0.7; background: rgba(255, 255, 255, 0.1) !important; color: rgb(136, 136, 136) !important; }

.btn-green { background: rgb(16, 185, 129); }

.btn-green:hover:not(:disabled) { background: rgb(5, 150, 105); box-shadow: rgba(16, 185, 129, 0.4) 0px 0px 10px; }

.btn-red { background: rgb(239, 68, 68); }

.btn-red:hover:not(:disabled) { background: rgb(220, 38, 38); box-shadow: rgba(239, 68, 68, 0.4) 0px 0px 10px; }

.btn-blue { background: rgb(59, 130, 246); }

.btn-blue:hover:not(:disabled) { background: rgb(37, 99, 235); box-shadow: rgba(59, 130, 246, 0.4) 0px 0px 10px; }

.btn-yellow { background: rgb(245, 158, 11); color: rgb(255, 255, 255); }

.btn-yellow:hover:not(:disabled) { background: rgb(217, 119, 6); box-shadow: rgba(245, 158, 11, 0.4) 0px 0px 10px; }

.perks-container { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }

.perk-badge { position: relative; cursor: help; padding: 8px 15px; border-radius: 20px; font-size: 14px; border: 1px solid transparent; transition: 0.3s; display: inline-flex; align-items: center; }

.perk-active { background: rgba(139, 92, 246, 0.2); color: rgb(226, 232, 240); border-color: rgba(168, 85, 247, 0.4); font-weight: bold; }

.perk-inactive { background: rgba(255, 255, 255, 0.05); color: rgb(100, 116, 139); border-color: rgba(255, 255, 255, 0.1); opacity: 0.6; }

.perk-qty { background: rgb(168, 85, 247); color: white; font-size: 12px; padding: 2px 6px; border-radius: 10px; margin-left: 8px; }

.perk-qty.max-badge { background: linear-gradient(135deg, rgb(245, 158, 11), rgb(217, 119, 6)); box-shadow: rgba(245, 158, 11, 0.6) 0px 0px 5px; }

.perk-qty.ex-badge { background: linear-gradient(135deg, rgb(6, 182, 212), rgb(8, 145, 178)); box-shadow: rgba(6, 182, 212, 0.6) 0px 0px 5px; font-style: italic; letter-spacing: 1px; }

.perk-badge .tooltiptext { visibility: hidden; width: max-content; max-width: 220px; background-color: rgb(24, 19, 36); color: rgb(255, 255, 255); text-align: center; padding: 8px 10px; border-radius: 6px; border: 1px solid rgba(168, 85, 247, 0.4); position: absolute; z-index: 10; bottom: 120%; left: 50%; transform: translateX(-50%); opacity: 0; transition: opacity 0.3s, bottom 0.3s; font-size: 12px; font-weight: normal; line-height: 1.4; box-shadow: rgba(0, 0, 0, 0.6) 0px 4px 6px; pointer-events: none; }

.perk-badge:hover .tooltiptext { visibility: visible; opacity: 1; bottom: 130%; }

.tab-header { display: flex; border-bottom: 2px solid rgba(255, 255, 255, 0.1); background: rgba(0, 0, 0, 0.3); border-radius: 10px 10px 0px 0px; }

.tab-btn { flex: 1 1 0%; padding: 12px 15px; text-align: center; cursor: pointer; font-weight: bold; color: rgb(148, 163, 184); transition: 0.3s; }

.tab-btn:hover { background: rgba(255, 255, 255, 0.05); color: rgb(255, 255, 255); }

.tab-btn.active { color: rgb(255, 255, 255); border-bottom: 3px solid rgb(168, 85, 247); background: rgba(168, 85, 247, 0.15); }

.tab-content { display: none; padding: 20px; }

.tab-content.active { display: block; }

ul li, .tx-item { border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important; }

