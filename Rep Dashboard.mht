.tx-expense { color: rgb(248, 113, 113); font-weight: bold; }

.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; font-size: 13px; }

.cal-header { font-weight: bold; background: rgba(255, 255, 255, 0.05); padding: 8px 0px; border-radius: 4px; }

.cal-day { border: 1px solid rgba(255, 255, 255, 0.08); padding: 10px 2px; min-height: 40px; position: relative; border-radius: 6px; }

