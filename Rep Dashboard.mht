.text-cursor-item { position: absolute; user-select: none; white-space: nowrap; font-size: 1.25rem; font-weight: bold; color: rgb(192, 132, 252); text-shadow: rgba(192, 132, 252, 0.6) 0px 0px 8px; pointer-events: none; will-change: transform, opacity; }

@keyframes textCursorFloat { 
  0% { transform: translate(-50%, -50%) rotate(var(--base-angle)) translate(0px, 0px) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(var(--base-angle)) translate(var(--rx), var(--ry)) rotate(var(--rrot)); }
}

.grid-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 1000px; margin: auto; position: relative; z-index: 10; }

.card { background: rgba(22, 18, 33, 0.75); backdrop-filter: blur(14px); padding: 20px; border-radius: 12px; border: 1px solid rgba(168, 85, 247, 0.25); box-shadow: rgba(0, 0, 0, 0.6) 0px 10px 35px, rgba(168, 85, 247, 0.15) 0px 0px 20px; margin-bottom: 20px; color: rgb(226, 232, 240); position: relative; z-index: 10; }

h2, h3, h4 { color: rgb(255, 255, 255); letter-spacing: 0.5px; }

a { color: rgb(192, 132, 252); text-decoration: none; }

a:hover { color: rgb(168, 85, 247); }

.shop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.shop-item { border: 1px solid rgba(255, 255, 255, 0.15); padding: 10px; border-radius: 6px; text-align: center; background: rgba(255, 255, 255, 0.05); }

select, input { padding: 10px; margin: 5px 0px; width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 6px; color: rgb(255, 255, 255); outline: none; }

select option { background: rgb(24, 19, 36); color: rgb(255, 255, 255); }

